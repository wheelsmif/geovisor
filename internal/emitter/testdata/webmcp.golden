const __geovisorDefinitions = [{"name":"complex_tool","description":"Submit \u003c/script\u003e safely \u2028 without embedding current values.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"Search text \u003c/script\u003e","enum":["\u003c/script\u003e","alpha"]},"options":{"type":"object","description":"Optional nested controls","properties":{"count":{"type":"integer","description":"Optional count"},"filters":{"type":"object","properties":{"label":{"type":"string","enum":["safe","unsafe"]}},"additionalProperties":false},"tags":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string"}},"additionalProperties":false}}},"required":["filters","tags"],"additionalProperties":false}},"required":["query"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"consequentialHint":true,"untrustedContentHint":false},"actions":[{"action":"click","locatorCandidateIds":["submit-button"],"sideEffect":{"class":"submission","safeForExploration":false,"rationale":"Submits the form."}},{"action":"fill","inputParameter":"query","locatorCandidateIds":["query-input"],"sideEffect":{"class":"none","safeForExploration":true}}],"locators":[{"id":"submit-button","framePath":[{"semantic":{"role":"iframe","name":"Checkout"},"cssFallback":"iframe.checkout"}],"shadowPath":[{"cssFallback":"checkout-form"}],"semantic":{"scope":[{"role":"form","name":"Search"}],"role":"button","name":"Submit \u003c/script\u003e"},"cssFallback":"button[type=\"submit\"]","confidence":{"score":0.8},"provenance":[{"kind":"accessibility"}]},{"id":"query-input","framePath":[],"shadowPath":[],"semantic":{"scope":[],"role":"searchbox","name":"Query"},"cssFallback":"#query","confidence":{"score":0.95},"provenance":[{"kind":"accessibility"}]}]},{"name":"read_only","description":"Inspect a local control.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":true,"consequentialHint":false,"untrustedCont