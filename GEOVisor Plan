## 5. TOOL INTERMEDIATE REPRESENTATION (TIR) SPECIFICATION

```go
package tir

type ParameterType string

const (
	TypeString  ParameterType = "string"
	TypeNumber  ParameterType = "number"
	TypeBoolean ParameterType = "boolean"
	TypeSelect  ParameterType = "select"
)

type ExtractionConfidence string

const (
	ConfidenceExplicit  ExtractionConfidence = "explicit"  // Direct <label>, aria-label, placeholder
	ConfidenceHeuristic ExtractionConfidence = "heuristic" // Inferred from DOM siblings/ancestor headers
	ConfidenceFallback  ExtractionConfidence = "fallback"  // Structural fallback context
)

type ToolParameter struct {
	Name            string               `json:"name"`
	Type            ParameterType        `json:"type"`
	Description     string               `json:"description"`
	Confidence      ExtractionConfidence `json:"confidence"`
	Required        bool                 `json:"required"`
	Enum            []string             `json:"enum,omitempty"`
	
	// Locators
	ScopedLocator   string               `json:"scoped_locator"` // e.g., "form#login >> role=textbox[name='Email']"
	FallbackCSS     string               `json:"fallback_css"`   // CSS selector from @medv/finder
}

type ToolDefinition struct {
	ID               string               `json:"id"`
	Name             string               `json:"name"`             // e.g., "submit_search_form"
	Description      string               `json:"description"`      // Extracted form summary or parent label
	TargetURL        string               `json:"target_url"`
	FrameURI         string               `json:"frame_uri,omitempty"` // Cross-origin iframe identifier
	ContainerLocator string               `json:"container_locator"`   // Parent scoping selector (form/dialog/nav)
	ActionType       string               `json:"action_type"`         // "submit", "click", "fill"
	Parameters       []ToolParameter      `json:"parameters"`
	ReadOnly         bool                 `json:"read_only"`
}

type ToolSet struct {
	SourceURL string           `json:"source_url"`
	Metadata  map[string]any   `json:"metadata"`
	Tools     []ToolDefinition `json:"tools"`
}
```

